# Copy to .env and adjust. No API keys are needed: market data comes from the
# TradingView MCP server running against your local TradingView Desktop.

# Risk settings. The optional planning amount ("if I trade with $100…") is entered in the
# dashboard; nothing is read from a broker or from TradingView.
FXSIG_ACCOUNT_CURRENCY=USD
FXSIG_RISK_PER_TRADE_PCT=1.0
# Loss already realised today (% of balance) — enforces the max-daily-loss limit
FXSIG_DAILY_LOSS_USED_PCT=0

# Telegram alerts (new signals, results, scanner problems). Create a bot with @BotFather,
# paste its token here, message the bot once, then run: .venv/bin/python -m fxsignals telegram-setup
TELEGRAM_BOT_TOKEN=
# Optional: set the chat id directly instead of using telegram-setup
TELEGRAM_CHAT_ID=

# Outside monitor for "Mac offline / asleep / no internet": a healthchecks.io ping URL.
# The scanner pings it every 10 minutes; if the pings stop, healthchecks.io alerts your Telegram.
HEALTHCHECK_URL=

# Scheduler
FXSIG_SCAN_INTERVAL_MINUTES=15

# Path to the TradingView MCP server (see README step 2)
TV_MCP_SERVER_PATH=~/tradingview-mcp/src/server.js
# TradingView Desktop remote-debugging port (read by the MCP server)
TV_CDP_PORT=9222

# Online access (README step 9): emails allowed to run scans / change settings, and your dashboard link
FXSIG_ADMIN_EMAILS=
FXSIG_PUBLIC_URL=

FXSIG_DASHBOARD_PORT=8765
FXSIG_LOG_LEVEL=INFO
